---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getAssetPath } from "@/utils/withBase";

const description =
  "Mithril is a research initiative to develop a secure-by-default RISC-V system-on-chip for resource-constrained IoT devices.";
const principles = [
  {
    number: "01",
    title: "Protection as the default",
    text: "The platform will aim to establish a protection policy during boot and retain it throughout normal execution, with hardware locks preventing runtime software from disabling it.",
  },
  {
    number: "02",
    title: "Designed for constraints",
    text: "Processing time, memory, energy and hardware area will guide the design. The research will evaluate how much protection can be provided within practical IoT resource budgets.",
  },
  {
    number: "03",
    title: "One coordinated system",
    text: "Hardware, boot firmware, the compiler and the operating system will be developed together so that protection can remain consistent across application and task transitions.",
  },
];
const layers = [
  {
    number: "01",
    title: "Firmware-bound identity",
    label: "BootROM · DICE",
    text: "Immutable boot code will measure firmware and derive identity material using the Device Identifier Composition Engine (DICE) approach. Firmware measurements will contribute to the derived identity chain.",
  },
  {
    number: "02",
    title: "Execution and memory policy",
    label: "DSEE · SHA-256 · execute-only memory",
    text: "The Dynamic Secure Execution Engine (DSEE) will be designed to pause execution at firmware handoffs, check image digests against a locked whitelist and reject mismatches. Bus-level policies will address access to executable memory.",
  },
  {
    number: "03",
    title: "Control-flow protection",
    label: "Pointer authentication · landing pads",
    text: "Pointer authentication will protect function and trap return state. RISC-V landing-pad checks will constrain eligible indirect branches to marked entry points. The compiler will supply the corresponding instrumentation.",
  },
  {
    number: "04",
    title: "An integrated software environment",
    label: "Compiler · Zephyr RTOS · HAL",
    text: "The software work will include compiler support, Zephyr real-time operating system (RTOS) integration and a hardware abstraction layer (HAL). Task switching and interrupts will be designed to preserve the required protection state.",
  },
];
const roadmap = [
  {
    step: "Define",
    title: "Architecture & scope",
    text: "Specify the threat model, protection policy, hardware interfaces and target resource budgets.",
  },
  {
    step: "Develop",
    title: "Hardware & software",
    text: "Build the processor extensions, execution engine, boot firmware and supporting software stack.",
  },
  {
    step: "Evaluate",
    title: "FPGA & security tests",
    text: "Investigate enforcement, formal properties, performance, resource use and physical leakage.",
  },
  {
    step: "Share",
    title: "Research & documentation",
    text: "Document the architecture, evaluation methods and findings as the research progresses.",
  },
];
const contact =
  "mailto:yusuf@yusufyamak.com?subject=Mithril%20research%20enquiry";
const about = getRelativeLocaleUrl(Astro.currentLocale ?? "en", "about");
---

<Layout
  title="Mithril — Secure-by-default RISC-V for IoT"
  description={description}
  ogImage={getAssetPath("mithril/social.png")}
>
  <div class="mithril-page">
    <Header />
    <main id="main-content" class="project-wrap" data-pagefind-body>
      <section class="hero" aria-labelledby="project-title">
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="status-dot" aria-hidden="true"></span> A research initiative
            by Yusuf Yamak
          </p>
          <h1 id="project-title">Mithril<span>.</span></h1>
          <p class="hero-statement">Security, <span>by default.</span></p>
          <p class="hero-description">
            A proposed RISC-V system-on-chip for resource-constrained Internet
            of Things devices. Designed around one goal: make protection part of
            the platform’s normal operation.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="#architecture"
              >Explore the vision <span aria-hidden="true">↘</span></a
            >
            <a class="text-link" href="#contact"
              >Get in touch <span aria-hidden="true">↗</span></a
            >
          </div>
          <p class="hero-meta">RISC-V / HARDWARE SECURITY / IoT</p>
        </div>
        <figure class="chip-figure">
          <svg
            viewBox="0 0 480 480"
            role="img"
            aria-labelledby="chip-title chip-desc"
          >
            <title id="chip-title">
              Mithril conceptual processor illustration
            </title>
            <desc id="chip-desc"
              >A processor at the centre of a circuit, with identity, execution,
              control-flow and software layers around it. This illustration
              represents the proposed platform.</desc
            >
            <defs>
              <pattern
                id="chip-grid"
                width="24"
                height="24"
                patternUnits="userSpaceOnUse"
                ><circle cx="1" cy="1" r="1" fill="#284353"></circle></pattern
              >
              <linearGradient id="core-fill" x1="0" y1="0" x2="1" y2="1"
                ><stop stop-color="#193642"></stop><stop
                  offset="1"
                  stop-color="#0b1b26"></stop></linearGradient
              >
            </defs>
            <rect width="480" height="480" rx="22" fill="#0b1721"></rect>
            <rect
              x="16"
              y="16"
              width="448"
              height="448"
              rx="12"
              fill="url(#chip-grid)"></rect>
            <g fill="none" stroke="#355260" stroke-width="1.5">
              <path
                d="M0 154h80l34 34h42M0 186h57l34 34h65M0 326h80l34-34h42M0 358h57l66-66"
              ></path>
              <path
                d="M480 154h-80l-34 34h-42M480 186h-57l-34 34h-65M480 326h-80l-34-34h-42M480 358h-57l-66-66"
              ></path>
              <path
                d="M154 0v80l34 34v42M186 0v57l34 34v65M326 0v80l-34 34v42M358 0v57l-66 66"
              ></path>
              <path
                d="M154 480v-80l34-34v-42M186 480v-57l34-34v-65M326 480v-80l-34-34v-42M358 480v-57l-66-66"
              ></path>
              <rect
                x="139"
                y="139"
                width="202"
                height="202"
                rx="16"
                stroke-dasharray="3 7"></rect>
            </g>
            <g fill="none" stroke="#5eead4" stroke-width="2">
              <path d="M240 82v73M82 240h73M325 240h73M240 325v73"></path>
              <circle cx="240" cy="82" r="5" fill="#0b1721"></circle><circle
                cx="82"
                cy="240"
                r="5"
                fill="#0b1721"></circle>
              <circle cx="398" cy="240" r="5" fill="#0b1721"></circle><circle
                cx="240"
                cy="398"
                r="5"
                fill="#0b1721"></circle>
            </g>
            <rect
              x="155"
              y="155"
              width="170"
              height="170"
              rx="12"
              fill="url(#core-fill)"
              stroke="#5eead4"
              stroke-width="1.5"></rect>
            <rect
              x="166"
              y="166"
              width="148"
              height="148"
              rx="6"
              fill="none"
              stroke="#355260"></rect>
            <path
              d="M202 250v-47l38 29 38-29v47M202 217l38 29 38-29"
              fill="none"
              stroke="#d4faf2"
              stroke-width="4"
              stroke-linejoin="round"></path>
            <text
              x="240"
              y="285"
              text-anchor="middle"
              fill="#9ac1c9"
              font-family="monospace"
              font-size="12"
              letter-spacing="3">RISC-V</text
            >
            <g
              fill="#b9d1d8"
              font-family="monospace"
              font-size="11"
              letter-spacing="1.3"
              text-anchor="middle"
            >
              <text x="240" y="62">IDENTITY</text><text x="240" y="425"
                >SOFTWARE</text
              >
              <text transform="translate(59 240) rotate(-90)">EXECUTION</text
              ><text transform="translate(423 240) rotate(90)"
                >CONTROL FLOW</text
              >
            </g>
          </svg>
          <figcaption>
            <span>Conceptual platform</span><span>RV32 / IoT</span>
          </figcaption>
        </figure>
      </section>

      <nav class="section-nav" aria-label="Mithril page sections">
        <a href="#vision">The vision</a><a href="#architecture">Architecture</a
        ><a href="#research">Research</a><a href="#contact">Contact</a>
      </nav>

      <section id="vision" class="section" aria-labelledby="vision-title">
        <div class="section-heading">
          <p class="eyebrow">01 / THE VISION</p>
          <h2 id="vision-title">
            Small devices.<br />A system-wide approach to security.
          </h2>
          <p>
            IoT devices have tight resource budgets. Mithril will explore how
            hardware and software can work together to make protection
            practical, consistent and enabled by default.
          </p>
        </div>
        <div class="principles">
          {
            principles.map(item => (
              <article>
                <span class="item-number" aria-hidden="true">
                  {item.number}
                </span>
                <>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </>
              </article>
            ))
          }
        </div>
      </section>

      <section
        id="architecture"
        class="section"
        aria-labelledby="architecture-title"
      >
        <div class="section-heading">
          <p class="eyebrow">02 / PROPOSED ARCHITECTURE</p>
          <h2 id="architecture-title">
            From the first instruction<br />to the application.
          </h2>
          <p>
            The design will centre on a small Ibex-class RV32 processor. Four
            coordinated layers will connect firmware identity, execution policy,
            control-flow checks and the software environment.
          </p>
        </div>
        <div class="architecture-layout">
          <figure class="architecture-diagram">
            <div class="diagram-heading">
              <span class="status-dot" aria-hidden="true"></span> DESIGN CONCEPT
            </div>
            <div class="diagram-node">
              <span class="diagram-label">TRUSTED START</span><strong
                >BootROM + DICE</strong
              ><span>Firmware measurement & identity</span>
            </div>
            <div class="diagram-connector" aria-hidden="true">↓</div>
            <div class="diagram-node">
              <span class="diagram-label">EXECUTION POLICY</span><strong
                >DSEE + memory protection</strong
              ><span>Image verification & access rules</span>
            </div>
            <div class="diagram-connector" aria-hidden="true">↓</div>
            <div class="diagram-node core-node">
              <span class="diagram-label">RISC-V PROCESSOR</span><strong
                >Ibex-class RV32</strong
              ><div class="core-features">
                <span>Return checks</span><span>Landing pads</span>
              </div>
            </div>
            <div class="diagram-connector" aria-hidden="true">↕</div>
            <div class="diagram-node">
              <span class="diagram-label">SOFTWARE ENVIRONMENT</span><strong
                >Compiler + Zephyr + HAL</strong
              ><span>Calls, tasks & interrupts</span>
            </div>
            <figcaption>
              Conceptual relationships in the proposed platform.
            </figcaption>
          </figure>
          <div class="layer-list">
            {
              layers.map((layer, i) => (
                <details open={i === 0}>
                  <summary>
                    <>
                      <span class="layer-number">{layer.number}</span>
                      <span>{layer.title}</span>
                      <span class="expand-icon" aria-hidden="true" />
                    </>
                  </summary>
                  <div class="layer-content">
                    <>
                      <p class="layer-label">{layer.label}</p>
                      <p>{layer.text}</p>
                    </>
                  </div>
                </details>
              ))
            }
            <p class="architecture-note">
              The research will define each mechanism’s guarantees within an
              explicit threat model and supported software configuration.
            </p>
          </div>
        </div>
      </section>

      <section id="research" class="section" aria-labelledby="research-title">
        <div class="section-heading">
          <p class="eyebrow">03 / RESEARCH DIRECTIONS</p>
          <h2 id="research-title">
            Design the protection.<br />Investigate the trade-offs.
          </h2>
          <p>
            The evaluation will examine security properties alongside the
            processing, memory, energy and hardware costs of enabling them.
          </p>
        </div>
        <div class="research-grid">
          <article>
            <span class="research-tag">SYSTEM ASSURANCE</span><h3>
              How can the policy stay enforced?
            </h3><p>
              Attack-response experiments and formal modelling will investigate
              policy locks, firmware transitions and the handling of protected
              execution state.
            </p>
          </article>
          <article>
            <span class="research-tag">RESOURCE COST</span><h3>
              What will protection cost?
            </h3><p>
              FPGA experiments will compare matched configurations and examine
              application performance, code size, boot latency, RTOS behaviour
              and hardware resources.
            </p>
          </article>
          <article class="physical-research">
            <span class="research-tag">PHYSICAL VALIDATION</span><h3>
              How much can power traces reveal?
            </h3><p>
              Stochastic Pipeline Flooding (SPF) will be investigated as a way
              to add dummy cryptographic activity alongside pointer
              authentication. ChipWhisperer experiments will assess its effect
              on physical leakage and its energy cost.
            </p><div class="signal-art" aria-hidden="true">
              <svg viewBox="0 0 640 50"
                ><path
                  d="M0 25h35l6-14 7 30 7-30 7 14h63l6-18 7 36 7-27 7 9h58l6-14 7 30 7-30 7 14h62l6-18 7 36 7-27 7 9h58l6-14 7 30 7-30 7 14h62l6-18 7 36 7-27 7 9h58l6-14 7 30 7-30 7 14h36"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"></path></svg
              ><span>Conceptual activity pattern</span>
            </div>
          </article>
        </div>
      </section>

      <section class="section" aria-labelledby="path-title">
        <div class="section-heading">
          <p class="eyebrow">04 / DEVELOPMENT PATH</p>
          <h2 id="path-title">From research questions<br />to a platform.</h2>
          <p>
            The work will progress through architecture definition, coordinated
            implementation and experimental evaluation.
          </p>
        </div>
        <ol class="roadmap">
          {
            roadmap.map((item, i) => (
              <li>
                <>
                  <div class="roadmap-marker">
                    <>
                      <span>{String(i + 1).padStart(2, "0")}</span>
                      <span>{item.step}</span>
                    </>
                  </div>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </>
              </li>
            ))
          }
        </ol>
      </section>

      <section
        id="contact"
        class="contact-section"
        aria-labelledby="contact-title"
      >
        <div>
          <p class="eyebrow">LET’S TALK</p>
          <h2 id="contact-title">
            Interested in secure<br />embedded systems?
          </h2>
          <p>
            I’m Yusuf Yamak, an embedded systems engineer and doctoral
            researcher. Mithril will bring together my work on computer
            architecture, firmware and hardware security.
          </p>
          <p>
            I welcome conversations with researchers, embedded teams and
            potential collaborators about the project’s direction and future
            applications.
          </p>
          <a class="button primary" href={contact}
            >Contact Yusuf <span aria-hidden="true">↗</span></a
          >
          <a class="contact-address" href={contact}>yusuf@yusufyamak.com</a>
        </div>
        <a class="about-link" href={about}
          >More about my work <span aria-hidden="true">→</span></a
        >
      </section>
    </main>
    <Footer />
  </div>
</Layout>

<style>
  .mithril-page {
    --project-accent: #0f766e;
    --project-soft: #e9f4f1;
    --project-ink: #142d38;
    --project-copy: #475569;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }
  :global([data-theme="dark"]) .mithril-page {
    --project-accent: #5eead4;
    --project-soft: #112d31;
    --project-ink: #e2e8f0;
    --project-copy: #afbdcd;
  }
  .mithril-page :global(header.app-layout),
  .mithril-page :global(footer.app-layout) {
    max-width: 1160px;
    font-family: var(--font-app), monospace;
  }
  .project-wrap {
    max-width: 1160px;
    padding: 0 24px;
    margin: auto;
  }
  .hero {
    display: grid;
    grid-template-columns: 1.18fr 1fr;
    align-items: center;
    gap: 64px;
    padding: 90px 0 62px;
  }
  .eyebrow,
  .hero-meta,
  .item-number,
  .diagram-heading,
  .diagram-label,
  .layer-label,
  .layer-number,
  .research-tag,
  .roadmap-marker,
  .chip-figure figcaption {
    font-family: var(--font-app), monospace;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--project-accent);
    font-size: 11px;
    line-height: 1.7;
    letter-spacing: 0.08em;
    font-weight: 600;
  }
  .status-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    flex: 0 0 auto;
  }
  h1 {
    font-size: clamp(64px, 7vw, 94px);
    letter-spacing: -0.065em;
    line-height: 1.08;
    font-weight: 700;
    margin: 22px 0 10px;
    color: var(--project-ink);
  }
  h1 span {
    color: var(--project-accent);
  }
  .hero-statement {
    font-size: clamp(25px, 3vw, 34px);
    line-height: 1.3;
    letter-spacing: -0.04em;
    font-weight: 500;
    color: var(--project-ink);
  }
  .hero-statement span {
    color: var(--project-accent);
  }
  .hero-description {
    font-size: 17px;
    line-height: 1.8;
    color: var(--project-copy);
    max-width: 490px;
    margin-top: 24px;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 30px;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 26px;
    padding: 13px 19px;
    border-radius: 5px;
    font-size: 14px;
    font-weight: 600;
    transition:
      transform 0.16s ease,
      opacity 0.16s ease;
  }
  .primary {
    background: var(--project-accent);
    color: var(--background);
  }
  .button:hover {
    transform: translateY(-2px);
    opacity: 0.92;
  }
  .text-link {
    color: var(--project-ink);
    font-size: 14px;
    font-weight: 600;
  }
  .text-link:hover,
  .about-link:hover,
  .contact-address:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .hero-meta {
    margin-top: 31px;
    color: var(--project-copy);
    font-size: 10px;
    letter-spacing: 0.1em;
  }
  .chip-figure svg {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 20px 30px rgb(15 32 40 / 10%));
  }
  .chip-figure figcaption {
    display: flex;
    justify-content: space-between;
    color: var(--project-copy);
    margin-top: 17px;
    font-size: 10px;
  }
  .section-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    border-block: 1px solid var(--border);
    padding: 20px 0;
    font-size: 13px;
    color: var(--project-copy);
  }
  .section-nav a:hover {
    color: var(--project-accent);
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .section {
    padding: 78px 0;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 30px;
  }
  .section-heading {
    max-width: 700px;
    margin-bottom: 38px;
  }
  h2 {
    font-size: clamp(28px, 3.4vw, 39px);
    line-height: 1.2;
    letter-spacing: -0.04em;
    font-weight: 600;
    color: var(--project-ink);
    margin: 15px 0 20px;
  }
  .section-heading > p:last-child {
    color: var(--project-copy);
    font-size: 16px;
    line-height: 1.8;
    max-width: 620px;
  }
  h3 {
    color: var(--project-ink);
    font-size: 18px;
    letter-spacing: -0.015em;
    line-height: 1.45;
    font-weight: 600;
  }
  .principles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .principles article {
    border-top: 2px solid var(--project-accent);
    padding-top: 18px;
  }
  .item-number {
    font-size: 12px;
    color: var(--project-accent);
  }
  .principles h3 {
    margin: 15px 0 11px;
  }
  .principles p,
  .research-grid p,
  .roadmap p {
    color: var(--project-copy);
    font-size: 15px;
    line-height: 1.8;
  }
  .architecture-layout {
    display: grid;
    grid-template-columns: 0.88fr 1.12fr;
    gap: 54px;
    align-items: start;
  }
  .architecture-diagram {
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 24px;
    background: var(--project-soft);
  }
  .diagram-heading {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--project-accent);
    margin-bottom: 25px;
  }
  .diagram-node {
    padding: 17px 12px;
    border: 1px solid var(--border);
    border-radius: 5px;
    text-align: center;
    display: grid;
    gap: 7px;
    background: var(--background);
  }
  .diagram-label {
    font-size: 9px;
    letter-spacing: 0.09em;
    color: var(--project-accent);
  }
  .diagram-node strong {
    font-size: 15px;
    color: var(--project-ink);
    font-weight: 600;
  }
  .diagram-node > span:last-child {
    font-size: 12px;
    color: var(--project-copy);
  }
  .diagram-connector {
    text-align: center;
    color: var(--project-accent);
    line-height: 30px;
  }
  .core-node {
    border-color: var(--project-accent);
  }
  .core-features {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 4px;
  }
  .core-features span {
    padding: 5px 7px;
    background: var(--project-soft);
    border-radius: 3px;
    font-size: 11px;
    color: var(--project-accent);
  }
  .architecture-diagram figcaption {
    color: var(--project-copy);
    font-size: 11px;
    line-height: 1.6;
    margin-top: 19px;
    text-align: center;
  }
  .layer-list details {
    border-bottom: 1px solid var(--border);
  }
  .layer-list summary {
    list-style: none;
    display: grid;
    grid-template-columns: 25px 1fr 20px;
    align-items: start;
    gap: 14px;
    padding: 24px 0;
    cursor: pointer;
    color: var(--project-ink);
    font-size: 18px;
    font-weight: 600;
  }
  .layer-list summary::-webkit-details-marker {
    display: none;
  }
  .layer-list summary:hover {
    color: var(--project-accent);
  }
  .layer-list summary:focus-visible {
    outline: 2px solid var(--project-accent);
    outline-offset: 5px;
    border-radius: 3px;
  }
  .layer-number {
    padding-top: 4px;
    font-size: 11px;
    font-weight: 400;
    color: var(--project-accent);
  }
  .expand-icon {
    position: relative;

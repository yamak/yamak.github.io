---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
---

<Layout>
  <Header />

  <main id="main-content" class="app-layout my-1">
    <section id="hero" class="border-border border-b pt-12 pb-10">
      <p class="text-muted-foreground mb-3 font-medium">
        Embedded Systems Engineer · Doctoral Researcher
      </p>

      <h1 class="my-4 text-4xl font-bold sm:text-5xl">Yusuf Yamak</h1>

      <p class="max-w-2xl text-lg leading-relaxed">
        I work at the intersection of embedded systems, operating systems,
        computer architecture, and hardware security.
      </p>

      <p class="text-muted-foreground mt-4 max-w-2xl leading-relaxed">
        This site is where I document practical experiments, research notes,
        engineering decisions, and open-source work.
      </p>

      <p class="text-muted-foreground mt-4">
        Embedded Linux · Yocto · RISC-V · Trusted Execution · Hardware Security
      </p>

      <div class="mt-6">
        <Socials />
      </div>
    </section>
    <section
      aria-labelledby="mithril-title"
      class="border-border border-b py-10"
    >
      <p class="text-accent mb-3 text-sm font-medium">Research initiative</p>
      <h2 id="mithril-title" class="mb-4 text-2xl font-semibold">
        Mithril: security, by default.
      </h2>
      <p class="text-muted-foreground leading-relaxed">
        A proposed RISC-V system-on-chip for resource-constrained IoT devices.
        The research will explore how hardware, firmware and the software stack
        can make protection practical and enabled by default.
      </p>
      <a
        href={getRelativeLocaleUrl(Astro.currentLocale ?? "en", "mithril")}
        class="text-accent mt-5 inline-block font-medium underline underline-offset-4"
      >
        Explore Mithril <span aria-hidden="true">→</span>
      </a>
    </section>
  </main>

  <Footer />
</Layout>
